{
  "manifest_version": 2,
  "name": "FetchX",
  "version": "0.2.0",
  "description": "Capture links, intercept downloads, scan page resources — send everything to FetchX.",

  "browser_specific_settings": {
    "gecko": {
      "id": "FetchX@FetchX.app",
      "strict_min_version": "109.0"
    }
  },

  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "tabs",
    "downloads",
    "storage",
    "notifications",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["dist/background.js"],
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "FetchX",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

