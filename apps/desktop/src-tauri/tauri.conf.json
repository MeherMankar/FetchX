{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FetchX",
  "version": "0.1.0",
  "identifier": "com.fetchx.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FetchX",
        "width": 1000,
        "height": 700,
        "minWidth": 760,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "resources": {
      "../../../target/release/fetchx-native-host*": "engines/"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer.nsh"
      }
    }
  }
}
