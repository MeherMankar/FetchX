{
  "manifest_version": 2,
  "name": "FetchX Widevine",
  "version": "1.0.0",
  "description": "Intercepts Widevine license requests and forwards extracted DRM keys to FetchX.",
  "browser_specific_settings": {
    "gecko": {
      "id": "widevine@fetchx.dev"
    }
  },
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "storage",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["library/isolated/bundle.min.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["library/main/bundle.min.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
