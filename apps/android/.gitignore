local.properties
.gradle/
build/
*/build/
*.apk
*.aab
captures/
.idea/
*.iml
*.hprof

# Kotlin daemon session files
.kotlin/

# Gradle wrapper (generated — checked in only if explicitly committed)
# gradle/wrapper/gradle-wrapper.jar
# gradlew
# gradlew.bat

# Gradle replay / crash logs
replay_pid*.log

# UniFFI Kotlin bindings are generated under the ignored bridge/build directory.
# Native .so files are generated by cargo-ndk and are not tracked; .gitkeep files
# preserve the jniLibs ABI directories.

# Rust-compiled native libraries — generated by cargo-ndk, not committed
bridge/src/main/jniLibs/**/*.so

# Bundled aria2c binaries — downloaded at dev-time, not committed to git
# (too large; use the download script or CI step to fetch them)
app/src/main/assets/bin/aria2c-*
