namespace android_bridge {};

[Error]
enum MobileApiError {
    "Validation",
    "NotFound",
    "UnavailableEngine",
    "InvalidStateTransition",
    "Storage",
    "Runtime",
};

dictionary CoreConfig {
    string database_path;
    string downloads_dir;
    string runtime_dir;
    string? yt_dlp_executable_path;
    string? aria2_executable_path;
};

callback interface YtDlpRuntime {
    string validate_version();
    string run(sequence<string> arguments, string progress_path, string cancel_path);
    string discover_formats(string url);
    void report_failure(string diagnostic_code);
};

dictionary YtDlpFormatDto {
    string format_id;
    string label;
    string? extension;
    string? title;
    string? platform;
};

dictionary TorrentTelemetryDto {
    u64? download_speed_bps;
    u64? upload_speed_bps;
    u64? downloaded_bytes;
    u64? uploaded_bytes;
    u64? peer_count;
    u64? completed_peer_count;
    u64? seed_count;
    f64? share_ratio;
    boolean? seeding;
    sequence<string>? tracker_uris;
};

dictionary TorrentFileDto {
    u32 index;
    string path;
    u64 size_bytes;
};

dictionary TorrentMetadataDto {
    string name;
    string info_hash;
    u64 total_size_bytes;
    sequence<TorrentFileDto> files;
    sequence<string> trackers;
    u64 piece_length;
    u64 piece_count;
};

dictionary TorrentDownloadMetadataDto {
    string metadata_state;
    TorrentMetadataDto? metadata;
    sequence<u32> selected_file_indexes;
    u64 selected_total_bytes;
    boolean selection_confirmed;
};

enum DownloadStatusDto {
    "Queued",
    "Preparing",
    "Downloading",
    "Paused",
    "Completed",
    "Failed",
    "Cancelled",
    "MetadataAcquiring",
    "Seeding",
    "Recovering",
    "Stopped",
};

enum DownloadPriorityDto {
    "Low",
    "Normal",
    "High",
};

dictionary DownloadProgressDto {
    u64 downloaded_bytes;
    i64 total_bytes;
    i64 speed_bytes_per_second;
    i64 estimated_remaining_seconds;
};

dictionary DownloadInfoDto {
    string id;
    string url;
    string engine;
    string filename;
    string destination;
    DownloadStatusDto status;
    DownloadPriorityDto priority;
    DownloadProgressDto progress;
    i64 created_at_millis;
    i64 updated_at_millis;
    string? error_message;
};

dictionary DownloadRuntimeStatusDto {
    string id;
    DownloadStatusDto status;
    DownloadRuntimeProgressDto progress;
    u64 updated_at;
};

dictionary DownloadRuntimeProgressDto {
    u64 downloaded_bytes;
    u64? total_bytes;
    u64? speed_bytes_per_second;
    u64? estimated_remaining_seconds;
    u16? percentage_basis_points;
};

dictionary DuplicateDownloadMatchDto {
    string id;
    string filename;
    DownloadStatusDto status;
    u64 updated_at;
};

[Enum]
interface DownloadEventDto {
    Created(DownloadInfoDto item);
    Updated(DownloadInfoDto item);
    Removed(string id);
};

callback interface DownloadEventListener {
    void on_event(DownloadEventDto event);
};

interface DownloadService {
    [Throws=MobileApiError]
    constructor(CoreConfig config, YtDlpRuntime? yt_dlp_runtime);

    [Throws=MobileApiError]
    sequence<DownloadInfoDto> list_downloads();

    [Throws=MobileApiError]
    boolean is_queue_dispatch_paused();

    [Throws=MobileApiError]
    void pause_queue_dispatch();

    [Throws=MobileApiError]
    void resume_queue_dispatch();

    [Throws=MobileApiError]
    sequence<DownloadRuntimeStatusDto> list_runtime_statuses();

    [Throws=MobileApiError]
    DuplicateDownloadMatchDto? find_duplicate_download(string url);

    [Throws=MobileApiError]
    string diagnostics_snapshot();

    sequence<string> extract_download_links(string text);

    string suggest_download_filename(string url);

    string suggest_download_package_name(string url, string filename);

    string normalize_download_url(string url);

    boolean is_duplicate_download_url(string url, sequence<string> existing_urls);

    string? match_download_category(string filename, string? url, string? page_url);

    [Throws=MobileApiError]
    DownloadInfoDto? get_download(string id);

    [Throws=MobileApiError]
    string add_download(
        string url,
        string filename,
        string destination,
        DownloadPriorityDto priority
    );

    [Throws=MobileApiError]
    string add_download_with_sha256(
        string url,
        string filename,
        string destination,
        DownloadPriorityDto priority,
        string expected_sha256
    );

    [Throws=MobileApiError]
    string add_magnet_download(
        string magnet_uri,
        DownloadPriorityDto priority
    );

    [Throws=MobileApiError]
    string add_torrent_file_download(
        string torrent_path,
        DownloadPriorityDto priority
    );

    [Throws=MobileApiError]
    TorrentMetadataDto inspect_torrent_file(string torrent_path);

    [Throws=MobileApiError]
    TorrentDownloadMetadataDto? get_torrent_download_metadata(string id);

    [Throws=MobileApiError]
    void select_torrent_files(string id, sequence<u32> selected_file_indexes);

    [Throws=MobileApiError]
    void set_torrent_file_selected(string id, u32 file_index, boolean selected);

    [Throws=MobileApiError]
    void set_torrent_selection_all(string id, boolean selected);

    [Throws=MobileApiError]
    void set_torrent_directory_selected(string id, string directory, boolean selected);

    [Throws=MobileApiError]
    string add_torrent_file_download_selected(
        string torrent_path,
        DownloadPriorityDto priority,
        sequence<u32> selected_file_indexes,
        string destination
    );

    [Throws=MobileApiError]
    string add_media_download(
        string url,
        string filename,
        string destination,
        DownloadPriorityDto priority,
        string? format_id
    );

    [Throws=MobileApiError]
    sequence<YtDlpFormatDto> discover_media_formats(string url);

    [Throws=MobileApiError]
    void pause_download(string id);

    [Throws=MobileApiError]
    void resume_download(string id);

    [Throws=MobileApiError]
    void cancel_download(string id);

    [Throws=MobileApiError]
    void remove_download(string id);

    [Throws=MobileApiError]
    string retry_download(string id);

    [Throws=MobileApiError]
    void set_priority(string id, DownloadPriorityDto priority);

    [Throws=MobileApiError]
    void move_download_up_in_queue(string id);

    [Throws=MobileApiError]
    void move_download_down_in_queue(string id);

    [Throws=MobileApiError]
    void schedule_download(string id, i64 start_at_millis);

    [Throws=MobileApiError]
    void stop_torrent_seeding(string id);

    [Throws=MobileApiError]
    TorrentTelemetryDto? get_torrent_telemetry(string id);

    [Throws=MobileApiError]
    string dispatch_browser_rpc(string request_json);

    void add_event_listener(DownloadEventListener listener);

    void shutdown();
};

interface PluginSecurityService {
    constructor();

    [Throws=MobileApiError]
    string evaluate_policy(string manifest_json, string trust_context_json);
};
